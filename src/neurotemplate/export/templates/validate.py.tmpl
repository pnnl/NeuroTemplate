"""Check that this package works on your machine:  python validate.py

Reproduces each reference/ fixture, which the *trained* model wrote at export
time, with this machine's runtime. Passing means the whole chain reproduces
the model: trained model -> export -> this runtime -> this platform. Exits
non-zero if any check fails.
"""

import sys

from runtime import check_reference

print("reproducing the trained model's own answers")
results = check_reference(".")
failures = 0
for result in results:
    print(result.report())
    print(f"  [{'PASS' if result.ok else 'FAIL'}] {result.name} matches "
          f"{result.name}/reference/")
    failures += not result.ok

print()
if failures:
    print(f"FAILED {failures} check(s)")
    sys.exit(1)
print(f"All {len(results)} check(s) passed.")
