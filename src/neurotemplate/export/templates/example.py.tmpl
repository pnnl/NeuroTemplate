"""The smallest useful program:  python example.py"""

from pathlib import Path

import numpy as np

from $package import Model, Policy, read_csv, read_windows

if Path("model").is_dir():
    model = Model("model")
    print(model.describe())

    # Physical units throughout; the model normalises internally.
    index, data = read_csv("model/reference/example_input.csv")
    print(f"\nloaded {len(index)} rows, {index[0]} .. {index[-1]}")

    # 1. A forecast of the whole window. The first `history_steps` rows are
    # the warm-up; after that the model feeds on its own predictions and
    # reads only the u and d columns.
    forecast = model.predict(data)
    s = model.history_steps
    for column in model.y_columns[:4]:
        rmse = np.sqrt(np.mean((forecast[column] - data[column][s:]) ** 2))
        print(f"  {column}: open-loop RMSE {rmse:.3f} against the recorded values")

    # 2. Step by step. `step` is pure: it returns a new State and never
    # modifies the one passed in. A controller chooses the u columns itself.
    state = model.warmup({c: v[:s] for c, v in data.items()})
    for k in range(12):
        state = model.step(state, {c: data[c][s + k - 1]
                                   for c in model.u_columns + model.d_columns})
    first = model.y_columns[0]
    print(f"\n12 steps later: {first} = {state.outputs[first]:.3f} "
          f"(recorded {data[first][s + 11]:.3f})")

if Path("policy").is_dir():
    policy = Policy("policy")
    print("\n" + policy.describe())
    # The shipped reference holds real windows from a closed-loop rollout.
    windows = read_windows("policy/reference/inputs.csv", policy.inputs)
    first = {name: window[0] for name, window in windows.items()}
    print("  first reference window ->", policy.act(**first))
